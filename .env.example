# Copie este archivo a .env para desarrollo local (no se sube a git).
# En producción, configure estas variables en Vercel:
#   Project Settings → Environment Variables

# ── Diagnóstico IA (opcional) ───────────────────────────────────────────────
# Consígalo gratis en https://aistudio.google.com/apikey
# Sin esta clave, la app funciona igual: el técnico escribe el diagnóstico
# manualmente y el botón "Generar con IA" muestra un aviso claro.
GEMINI_API_KEY=""

# Modelo de Gemini a usar (opcional, por defecto gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# ── Pagos con tarjeta Stripe (opcional) ─────────────────────────────────────
# Clave secreta de https://dashboard.stripe.com/apikeys (sk_live_... o sk_test_...)
# Sin esta clave, los cobros en Efectivo y Zelle funcionan normalmente y la
# opción "Tarjeta" aparece deshabilitada.
STRIPE_SECRET_KEY=""

# ── URL pública de la app (opcional) ────────────────────────────────────────
# Se usa para las URLs de retorno de Stripe Checkout. Si se omite, se deduce
# automáticamente de los headers de la petición (recomendado en Vercel).
# APP_URL="https://su-dominio.com"
